---
import Layout from '../layouts/Layout.astro';
import UserSettingsComponent from '../components/UserSettings';
---

<Layout title="Settings - Diet Machine">
  <main class="min-h-screen bg-gradient-to-br from-green-50 to-blue-50">
    <div class="container mx-auto px-4 py-8">
      <!-- Header -->
      <div class="mb-8">
        <a href="/" class="text-green-600 hover:text-green-700 font-semibold mb-4 inline-block">
          ← Back to Home
        </a>
        <h1 class="text-4xl font-bold text-gray-800">⚙️ Settings</h1>
        <p class="text-gray-600 mt-2">Configure your daily targets and weekly budget</p>
      </div>

      <!-- Settings Component -->
      <UserSettingsComponent client:load />
    </div>
  </main>
</Layout>