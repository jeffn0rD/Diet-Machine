---
import Layout from '../layouts/Layout.astro';
import MealPlanner from '../components/MealPlanner';
import MealPlanManager from '../components/MealPlanManager';
---

<Layout title="Meal Planner - Diet Machine">
  <main class="min-h-screen bg-gradient-to-br from-green-50 to-blue-50 py-8">
    <div class="container mx-auto px-4">
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-green-800 mb-2">Weekly Meal Planner</h1>
        <p class="text-gray-600">Select meals for each day and get instant nutritional breakdown and shopping list</p>
      </div>
      
      <!-- Meal Plan Save/Load Manager -->
      <div class="mb-8">
        <MealPlanManager client:load />
      </div>
      
      <!-- Main Meal Planner -->
      <MealPlanner client:load />
    </div>
  </main>
</Layout>