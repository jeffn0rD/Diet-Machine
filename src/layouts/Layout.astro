---
interface Props {
	title: string;
}

const { title } = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="High-Protein, Budget-Friendly Meal Planning" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<nav class="bg-white shadow-md sticky top-0 z-50">
			<div class="container mx-auto px-4 py-4">
				<div class="flex items-center justify-between">
					<a href="/" class="text-2xl font-bold text-green-700">🥗 Diet Machine</a>
					<div class="flex gap-6">
						<a href="/" class="text-gray-700 hover:text-green-600 transition">Home</a>
						<a href="/planner" class="text-gray-700 hover:text-green-600 transition">Planner</a>
						<a href="/meals" class="text-gray-700 hover:text-green-600 transition">Meals</a>
						<a href="/ingredients" class="text-gray-700 hover:text-green-600 transition">Ingredients</a>
						<a href="/settings" class="text-gray-700 hover:text-green-600 transition">⚙️ Settings</a>
					</div>
				</div>
			</div>
		</nav>
		<slot />
	</body>
</html>